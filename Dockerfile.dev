# Entwicklungscontainer — der Code wird NICHT eingebacken, sondern per
# Bind-Mount eingehängt (siehe docker-compose.yml). Das Image liefert nur
# die Laufzeitumgebung: Node 22 + OpenSSL (Prisma) + git.
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl git ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Expo/Metro-Cache außerhalb des Bind-Mounts halten
ENV EXPO_NO_TELEMETRY=1 \
    npm_config_update_notifier=false

CMD ["bash"]
